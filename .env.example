# Database (uses psycopg3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aistock

# AI Models - set to true to enable LLM-powered analysis (requires Ollama)
AI_MODELS_ENABLED=false

# AI Models Service (only needed if AI_MODELS_ENABLED=true)
AI_MODELS_URL=http://localhost:8001

# Ollama (for LLM generation - only needed if AI_MODELS_ENABLED=true)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Sentiment Model (HuggingFace - only needed if running ai_models service)
SENTIMENT_MODEL=ahmedrachid/FinancialBERT-Sentiment-Analysis
